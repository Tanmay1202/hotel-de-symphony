/out/
/build
/dist

# Raw Local Assets & Audit Data (Useless for production — web assets live in /public)
/photos/
/CONTACT_SHEET/
/screenshots/
/scratch/
*.log

# TypeScript Local Incremental Cache
*.tsbuildinfo

# Local Environment Variables & Vercel Project Link
.env*.local
.env
.vercel

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary Scratch Files & Python Artifacts
*.tmp
*.bak
*.pyc
